{
  "name": "usage-meow",
  "version": "0.5.0",
  "description": "用量喵：打开即查看本机 AI 编码助手用量",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "author": "Usage Meow",
  "license": "MIT",
  "devDependencies": {
    "ccusage": "20.0.24",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.local.usage-meow",
    "productName": "用量喵",
    "afterPack": "build/create-uninstall-manifest.cjs",
    "files": ["main.js", "preload.js", "usage-service.js", "usage-sources.js", "agent-sources.js", "report-merge.js", "pricing-catalog.js", "pricing-resolver.js", "pricing-seed.json", "account-service.js", "codex-client.js", "ui-smoke.js", "renderer/**", "assets/*.png", "assets/*.ico", "package.json"],
    "extraResources": [
      { "from": "node_modules/@ccusage/ccusage-win32-x64/bin/ccusage.exe", "to": "ccusage.exe" }
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "assets/usage-meow-icon.ico",
      "signExecutable": false
    },
    "portable": { "artifactName": "用量喵-${version}-便携版.exe" },
    "nsis": {
      "artifactName": "用量喵-${version}-安装包.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerIcon": "assets/usage-meow-icon.ico",
      "uninstallerIcon": "assets/usage-meow-icon.ico",
      "createDesktopShortcut": "always",
      "shortcutName": "用量喵"
    }
  }
}
